# MongoDB Atlas connection string (e.g. mongodb+srv://username:password@cluster0.xyz.mongodb.net/calm_motion?retryWrites=true&w=majority)
# If left blank, the app gracefully falls back to an in-memory & local JSON store for local testing
MONGODB_URI=""

# Secret key used for signing session tokens and clinic authentication
JWT_SECRET="calm-motion-jwt-secret-2026-key"

# Passcode required for clinic staff / therapist login to /clinic (default: CALM2026)
CLINIC_ADMIN_PASSCODE="CALM2026"
