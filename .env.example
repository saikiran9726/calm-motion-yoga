# MongoDB Atlas connection string (e.g. mongodb+srv://username:password@cluster0.xyz.mongodb.net/calm_motion?retryWrites=true&w=majority)
# Required in production; in local development, omits or falls back to in-memory store
MONGODB_URI=""

# Secret key used for signing clinic JWT tokens (must be at least 32 characters in production)
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Passcode required for clinic staff / therapist login to /clinic
CLINIC_ADMIN_PASSCODE="change-me-to-a-secure-clinic-passcode"

# Enable demo seeding API endpoint (/api/clinic/seed). Set to "true" only in test/demo environments
DEMO_MODE="false"

# Frontend flag to show demo credentials hint in the clinic portal UI. Set to "true" for local demo walkthroughs
VITE_DEMO_MODE="false"

